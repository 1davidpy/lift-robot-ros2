{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "STM32: F103C8T6_Chip (ST-LINK)",
            "type": "stlinkgdbtarget",
            "request": "launch",
            "origin": "workspace",
            "cwd": "${workspaceFolder}",
            "preBuild": "",
            "preLaunchTask": "build: F103C8T6_Chip (Debug)",
            "program": "${workspaceFolder}/build/f103c8-chip-debug/F103C8T6_Chip.elf",
            "deviceName": "STM32F103C8T6",
            "deviceCore": "Cortex-M3",
            "runEntry": "main",
            "serverInterface": "SWD",
            "serverInterfaceFrequency": "Auto",
            "serverVerify": true,
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}/build/f103c8-chip-debug/F103C8T6_Chip.elf",
                    "symbolFileName": "${workspaceFolder}/build/f103c8-chip-debug/F103C8T6_Chip.elf"
                }
            ],
            "serverRtos": {
                "enabled": true,
                "driver": "freertos",
                "driverPort": "ARM_CM3",
                "port": "60000"
            }
        },
