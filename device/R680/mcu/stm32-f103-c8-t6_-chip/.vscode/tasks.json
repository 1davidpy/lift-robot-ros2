{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configure: F103C8T6_Chip (Debug)",
            "type": "shell",
            "command": "${env:LOCALAPPDATA}/stm32cube/bundles/cmake/4.3.1+st.1/bin/cmake.exe",
            "args": [
                "--preset",
                "f103c8-chip-debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "build: F103C8T6_Chip (Debug)",
            "type": "shell",
            "command": "${env:LOCALAPPDATA}/stm32cube/bundles/cmake/4.3.1+st.1/bin/cmake.exe",
            "args": [
                "--build",
                "--preset",
                "f103c8-chip-debug"
            ],
            "dependsOn": "configure: F103C8T6_Chip (Debug)",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "clean: F103C8T6_Chip (Debug)",
            "type": "shell",
            "command": "${env:LOCALAPPDATA}/stm32cube/bundles/cmake/4.3.1+st.1/bin/cmake.exe",
            "args": [
                "--build",
                "--preset",
                "f103c8-chip-debug",
                "--target",
                "clean"
            ],
            "problemMatcher": []
        },
        {
            "label": "rebuild safely: F103C8T6_Chip (Debug)",
            "type": "shell",
            "command": "${env:LOCALAPPDATA}/stm32cube/bundles/cmake/4.3.1+st.1/bin/cmake.exe",
            "args": [
                "--build",
                "--preset",
                "f103c8-chip-debug"
            ],
            "dependsOrder": "sequence",
            "dependsOn": [
                "configure: F103C8T6_Chip (Debug)",
                "clean: F103C8T6_Chip (Debug)"
            ],
            "problemMatcher": "$gcc"
        },
