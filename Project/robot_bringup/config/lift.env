# Explicitly enabled by the dedicated service; no motion until dashboard start.
LIFT_INTERFACE=luxi_lift
LIFT_TRANSPORT=uart
# CH340 has no unique serial; retain the identified USB socket instead of
# selecting an arbitrary ttyUSB number or a non-unique by-id alias.
# 2026-10-08: current identified serial USB socket is 1.2 (verified 2026-10-20).
LIFT_SERIAL_PORT=/dev/serial/by-path/platform-xhci-hcd.2.auto-usb-0:1.2:1.0-port0
# Host bounds match UART firmware: -180..+180 mm; grip targets retain the margin.
LIFT_HOST_MIN_UM=-180000
LIFT_HOST_MAX_UM=180000
LIFT_NODE_ID=1
# Held-grip target inset from device-reported limits, micrometres.
LIFT_MARGIN_UM=5000
LIFT_ALLOW_MOTION=true
